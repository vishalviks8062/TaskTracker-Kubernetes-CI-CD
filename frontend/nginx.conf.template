server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Angular is a single-page app: any path that isn't a real static file
    # falls back to index.html so client-side routing (if you add any)
    # still works after a browser refresh.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Reverse proxy for the backend API. BACKEND_URL is a container env var
    # (see the frontend Deployment's ConfigMap reference), substituted into
    # this file at container startup by docker-entrypoint.sh. This proxy is
    # what lets the frontend talk to the backend's ClusterIP Service, which
    # the browser itself cannot reach directly.
    location /api/ {
        proxy_pass ${BACKEND_URL}/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
